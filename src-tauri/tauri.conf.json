{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Heel",
  "version": "0.1.5",
  "identifier": "studio.theft.heel",
  "build": {
    "beforeDevCommand": "npm run dev:all",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && npm run bundle:sidecar",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Heel",
        "width": 192,
        "height": 208,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "visibleOnAllWorkspaces": true,
        "focus": false,
        "acceptFirstMouse": true
      },
      {
        "label": "panel",
        "title": "Heel panel",
        "width": 300,
        "height": 420,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "visibleOnAllWorkspaces": true,
        "acceptFirstMouse": true,
        "minWidth": 280,
        "minHeight": 320,
        "maxWidth": 640,
        "maxHeight": 900
      },
      {
        "label": "notice",
        "title": "Heel notice",
        "width": 240,
        "height": 64,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "focusable": false,
        "visibleOnAllWorkspaces": true,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* https://heel-feedback.jason-poindexter.workers.dev; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "externalBin": [
      "binaries/heel-cv-text"
    ],
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/sidecar/**/*"
    ],
    "macOS": {
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://heel-feedback.jason-poindexter.workers.dev/updates/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIwRjY1QkJEMTNCQzI1MTgKUldRWUpid1R2VnYySUxoWEpVd1hlWGxuSnNVRmJnU1d4eWhCK05mNE5qM21lc2QwczhVVTFaUloK",
      "requireSignedVersion": true
    }
  }
}
