{
  "name": "heel",
  "private": true,
  "version": "0.1.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "release": "tauri build --bundles app,dmg",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p sidecar && tsc --noEmit -p tsconfig.node.json",
    "sidecar": "tsx sidecar/server/main.ts",
    "secrets:scan": "gitleaks detect --source . --redact --no-banner --config .gitleaks.toml",
    "dev:all": "concurrently -k -n vite,sidecar \"npm:dev\" \"npm:sidecar\"",
    "bundle:sidecar": "node scripts/bundle-sidecar.mjs",
    "smoke": "tsx sidecar/scripts/smoke.ts",
    "release:signed": "sh scripts/release-signed.sh"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@radix-ui/react-icons": "1.3.2",
    "@radix-ui/themes": "3.3.0",
    "@tauri-apps/api": "^2",
    "hono": "^4.13.13",
    "playwright-core": "1.65.0",
    "radix-ui": "1.8.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^10.0.6",
    "esbuild": "0.28.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.5"
  }
}
