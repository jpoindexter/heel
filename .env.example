# Heel — environment for a signed and notarized release build (docs/RELEASE.md).
# Never commit the real .env. Load it into the shell before `npm run release`:  set -a; source .env; set +a
# Tauri reads these itself during `tauri build` (https://v2.tauri.app/distribute/sign/macos/).

# The "Developer ID Application: …" identity from the login keychain (security find-identity -v -p codesigning).
APPLE_SIGNING_IDENTITY="Developer ID Application: Your Name (TEAMID)"

# Notarization, Apple ID route: your Apple account email, an app-specific password (appleid.apple.com), the team id.
APPLE_ID=you@example.com
APPLE_PASSWORD=xxxx-xxxx-xxxx-xxxx
APPLE_TEAM_ID=TEAMID

# Or the App Store Connect API route instead of the three above (leave the other set unset).
# APPLE_API_ISSUER=
# APPLE_API_KEY=
# APPLE_API_KEY_PATH=

# Dev-only switches the shell and helper understand (not for a release):
# HEEL_DATA_DIR=        a second data folder for a throwaway run
# HEEL_DEV_ORIGIN=      a second Vite origin the helper may answer (a worktree on another port)
# HEEL_NO_HOTKEY=1      start without the panel shortcut (B1 isolation)
# HEEL_ACCESSORY=1      start without a Dock icon (B1 isolation)
# HEEL_OLLAMA_URL=      Ollama somewhere other than 127.0.0.1:11434
