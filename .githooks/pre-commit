#!/bin/sh
# Block a commit that contains a secret. Install once per clone: git config core.hooksPath .githooks
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed (brew install gitleaks); skipping the secret scan." >&2
  exit 0
fi
gitleaks protect --staged --redact --no-banner --config .gitleaks.toml || {
  echo "pre-commit: a possible secret is staged. Remove it (rotate it if it was real), or allowlist a proven false positive in .gitleaks.toml." >&2
  exit 1
}
